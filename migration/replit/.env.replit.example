# Copy the variable names into Replit Secrets. Never commit real values.

# Required: external MySQL 8/TiDB database. Replit's built-in database is
# PostgreSQL and is not directly compatible with this application's schema.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=true

# Required: generate a new random value for the Replit environment.
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET

# Replit portability switches.
LOCAL_ASSET_MODE=true
DISABLE_MANUS_HEARTBEAT=true

# One-time super-admin seed. Remove these Secrets after `pnpm admin:seed`.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Stripe/GHL webhooks. Do not reuse signing secrets until the new webhook
# endpoint has been created in the provider dashboard.
STRIPE_WEBHOOK_SECRET=REPLACE_AFTER_CREATING_REPLIT_STRIPE_WEBHOOK
GHL_PAYMENT_WEBHOOK_URL=REPLACE_WITH_GHL_PAYMENT_WEBHOOK_URL
GHL_WL2_INTAKE_WEBHOOK_URL=REPLACE_WITH_GHL_WL2_INTAKE_WEBHOOK_URL

# Optional compatibility values. Public pages and direct super-admin login do
# not require Manus OAuth. Leave empty unless a replacement auth integration is
# deliberately configured.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Runtime-provided by Replit; do not normally set manually.
# PORT=3000
